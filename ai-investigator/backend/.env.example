# LLM settings (Phase 14b). NEVER commit this file (already git-ignored).
# Fill ONE provider and restart the backend. No key = rule-based mode.

# --- Meta Muse Spark (same model family as this project's assistant) ---
# Get a key at https://dev.meta.ai (dashboard → generate API key).
#LLM_BASE_URL=https://api.meta.ai/v1
#LLM_MODEL=muse-spark-1.3
#LLM_API_KEY=your-meta-key-here

# --- OpenAI ---
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=sk-your-key-here

# --- Google Gemini (OpenAI-compatible endpoint) ---
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-2.0-flash
#LLM_API_KEY=AIza-your-key-here

# --- Local Ollama (no key needed, but leave the field empty = disabled) ---
# Run: ollama pull llama3.1 && ollama serve
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=llama3.1
#LLM_API_KEY=ollama

#LLM_TIMEOUT_SECONDS=60
