# LLM settings (Phase 14b). NEVER commit this file (already git-ignored).
# Fill ONE provider and restart the backend. No key = rule-based mode.

# --- Meta Muse Spark (same model family as this project's assistant) ---
# Get a key at https://dev.meta.ai (dashboard → generate API key).
#LLM_BASE_URL=https://api.meta.ai/v1
#LLM_MODEL=muse-spark-1.3
#LLM_API_KEY=your-meta-key-here

# --- OpenAI ---
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=sk-your-key-here

# --- Google Gemini (OpenAI-compatible endpoint) ---
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-2.0-flash
#LLM_API_KEY=AIza-your-key-here

# --- Local Ollama (no key needed, but leave the field empty = disabled) ---
# Run: ollama pull llama3.1 && ollama serve
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=llama3.1
#LLM_API_KEY=ollama

#LLM_TIMEOUT_SECONDS=60

#LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# JIRA — BugZero reads the incident ticket and creates the permanent-fix one.
# Unset = intake falls back to free text, and handoff renders without sending.
# Create an API token: id.atlassian.com → Profile → Security → API tokens.
# ---------------------------------------------------------------------------
#JIRA_BASE_URL=https://your-team.atlassian.net
#JIRA_EMAIL=you@example.com
#JIRA_API_TOKEN=your-api-token
#JIRA_PROJECT_KEY=OPS
#JIRA_ISSUE_TYPE=Task
#JIRA_API_VERSION=3
#JIRA_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# EMAIL — the developer handoff notification. Unset = dry-run (rendered, not sent).
# STARTTLS is used automatically; SMTP_USE_SSL=true (or port 465) for implicit TLS.
# ---------------------------------------------------------------------------
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=bugzero@example.com
#SMTP_PASSWORD=your-app-password
#BUGZERO_MAIL_FROM=bugzero@example.com
#BUGZERO_MAIL_TO=dev1@example.com,dev2@example.com

# ---------------------------------------------------------------------------
# SSH LOG COLLECTION — read logs from approved servers over Paramiko.
# Unset = read local files. Requires `pip install paramiko`.
# ---------------------------------------------------------------------------
#BUGZERO_SSH_HOST=10.0.0.21
#BUGZERO_SSH_PORT=22
#BUGZERO_SSH_USER=ops-readonly
#BUGZERO_SSH_KEY=/Users/you/.ssh/bugzero_readonly
#BUGZERO_SSH_PASSWORD=            # only if no key
#BUGZERO_SSH_KEY_PASSPHRASE=
#BUGZERO_SSH_LOG_ROOT=/var/log/telecom
#BUGZERO_SSH_KNOWN_HOSTS=/Users/you/.ssh/known_hosts   # refuse unknown hosts
#BUGZERO_SSH_PORT_FORWARD=5433:localhost:5433          # tunnel to a bastion

# ---------------------------------------------------------------------------
# HISTORY — BugZero's own database. NEVER the telecom_* service databases.
# Create it once, then POST /api/setup/schema to create the tables.
# ---------------------------------------------------------------------------
#BUGZERO_DB_NAME=bugzero
